<Window
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:ui="clr-namespace:Communication.App.Presentation"
  xmlns:views="clr-namespace:Communication.App.Views"
  xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
  x:Class="Communication.App.Views.DataConverterWindow"
  x:Name="ToolWindow"
  Title="{ui:Loc Key=UiDataConverter}"
  Width="900"
  Height="560"
  MinWidth="720"
  MinHeight="400"
  WindowStartupLocation="CenterScreen"
  WindowStyle="None"
  ResizeMode="CanResize"
  Topmost="True"
  ShowInTaskbar="True"
  Style="{StaticResource {x:Type Window}}">
  <Window.Resources>
    <Style x:Key="ConverterEditorSurface" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource InputSurface}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Outline}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="5"/>
      <Style.Triggers>
        <Trigger Property="IsKeyboardFocusWithin" Value="True">
          <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="ConverterIconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Width" Value="30"/>
      <Setter Property="Height" Value="28"/>
      <Setter Property="Padding" Value="6"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="ConverterSwapButton" TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="Transparent">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
        </Trigger>
        <Trigger Property="IsKeyboardFocused" Value="True">
          <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
        </Trigger>
        <Trigger Property="IsEnabled" Value="False">
          <Setter Property="Opacity" Value="0.4"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    <Geometry x:Key="CopyIcon">M 5 5 H 13 V 15 H 5 Z M 3 11 H 1 V 1 H 9 V 3</Geometry>
  </Window.Resources>
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome
      CaptionHeight="42"
      ResizeBorderThickness="6"
      GlassFrameThickness="0"
      CornerRadius="0"
      UseAeroCaptionButtons="False"/>
  </shell:WindowChrome.WindowChrome>
  <Border BorderBrush="{DynamicResource Outline}" BorderThickness="1">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="42"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>
      <Grid Background="{DynamicResource Surface}">
        <TextBlock Text="{ui:Loc Key=UiDataConverter}" Margin="16,0" FontWeight="SemiBold"/>
        <StackPanel
          Orientation="Horizontal"
          HorizontalAlignment="Right"
          shell:WindowChrome.IsHitTestVisibleInChrome="True">
          <ToggleButton
            x:Name="PinButton"
            Width="42"
            IsChecked="{Binding Topmost, ElementName=ToolWindow, Mode=TwoWay}"
            ToolTip="{ui:Loc Key=UiPinToolWindow}">
            <ToggleButton.Style>
              <Style TargetType="ToggleButton">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template">
                  <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                      <Border Background="{TemplateBinding Background}">
                        <Path
                          Data="M 5 2 L 13 2 M 7 2 L 7 8 L 4 11 L 14 11 L 11 8 L 11 2 M 9 11 L 9 17"
                          Stroke="{TemplateBinding Foreground}"
                          StrokeThickness="1.5"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          Width="18"
                          Height="18"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"/>
                      </Border>
                    </ControlTemplate>
                  </Setter.Value>
                </Setter>
                <Style.Triggers>
                  <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                    <Setter Property="Background" Value="{DynamicResource ActiveSurface}"/>
                  </Trigger>
                  <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource HoverSurface}"/>
                  </Trigger>
                </Style.Triggers>
              </Style>
            </ToggleButton.Style>
          </ToggleButton>
          <Button
            x:Name="MinimizeButton"
            Content="—"
            Style="{StaticResource CaptionButton}"
            Click="MinimizeClick"
            ToolTip="{ui:Loc Key=UiMinimize}"/>
          <Button
            Content="✕"
            Style="{StaticResource CloseCaptionButton}"
            Click="CloseClick"
            ToolTip="{ui:Loc Key=UiClose}"/>
        </StackPanel>
      </Grid>
      <Grid Grid.Row="1" Margin="16">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="48"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <TextBlock Text="{ui:Loc Key=UiConverterInput}" FontWeight="SemiBold" Margin="0,0,0,8"/>
        <TextBlock Grid.Column="2" Text="{ui:Loc Key=UiConverterOutput}" FontWeight="SemiBold" Margin="0,0,0,8"/>
        <ComboBox
          x:Name="InputFormatPicker"
          Grid.Row="1"
          ItemsSource="{Binding Formats}"
          SelectedItem="{Binding InputFormat}"
          DisplayMemberPath="Name"/>
        <Button
          x:Name="SwapButton"
          Grid.Row="1"
          Grid.Column="1"
          Content="⇄"
          Style="{StaticResource ConverterSwapButton}"
          Command="{Binding SwapCommand}"
          Padding="0"
          Margin="6,0"
          VerticalAlignment="Center"
          Height="34"
          ToolTip="{ui:Loc Key=UiConverterSwap}"
          AutomationProperties.Name="{ui:Loc Key=UiConverterSwap}"/>
        <ComboBox
          x:Name="OutputFormatPicker"
          Grid.Row="1"
          Grid.Column="2"
          ItemsSource="{Binding Formats}"
          SelectedItem="{Binding OutputFormat}"
          DisplayMemberPath="Name"/>
        <CheckBox
          Grid.Row="2"
          Content="{ui:Loc Key=UiBigEndian}"
          IsChecked="{Binding InputBigEndian}"
          IsEnabled="{Binding InputUsesByteOrder}"
          Margin="0,10,0,12"
          ToolTip="{ui:Loc Key=UiConverterEndianTip}"/>
        <CheckBox
          Grid.Row="2"
          Grid.Column="2"
          Content="{ui:Loc Key=UiBigEndian}"
          IsChecked="{Binding OutputBigEndian}"
          IsEnabled="{Binding OutputUsesByteOrder}"
          Margin="0,10,0,12"
          ToolTip="{ui:Loc Key=UiConverterEndianTip}"/>
        <Border Grid.Row="3" Style="{StaticResource ConverterEditorSurface}">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="*"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBox
              x:Name="InputEditor"
              Text="{Binding Input, UpdateSourceTrigger=PropertyChanged}"
              AcceptsReturn="True"
              AcceptsTab="True"
              TextWrapping="Wrap"
              VerticalContentAlignment="Top"
              VerticalScrollBarVisibility="Auto"
              HorizontalScrollBarVisibility="Disabled"
              FontFamily="Consolas"
              Padding="10"
              BorderThickness="0"
              Background="Transparent"/>
            <Grid Grid.Row="1" Margin="6">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock
                Text="{Binding ByteCountText}"
                Foreground="{DynamicResource Muted}"
                Margin="4,0"
                VerticalAlignment="Center"/>
              <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button
                  x:Name="ClearInputButton"
                  Command="{Binding ClearCommand}"
                  Style="{StaticResource ConverterIconButton}"
                  ToolTip="{ui:Loc Key=UiConverterClear}"
                  AutomationProperties.Name="{ui:Loc Key=UiConverterClear}"
                  Margin="0,0,6,0">
                  <Path
                    Data="M 2 4 H 14 M 6 4 V 1 H 10 V 4 M 4 4 L 5 15 H 11 L 12 4 M 7 7 V 12 M 9 7 V 12"
                    Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                    StrokeThickness="1.2"
                    Width="16"
                    Height="16"/>
                </Button>
                <Button
                  x:Name="CopyInputButton"
                  Command="{Binding CopyInputCommand}"
                  Style="{StaticResource ConverterIconButton}"
                  ToolTip="{ui:Loc Key=UiConverterCopyInput}"
                  AutomationProperties.Name="{ui:Loc Key=UiConverterCopyInput}">
                  <Path
                    Data="{StaticResource CopyIcon}"
                    Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                    StrokeThickness="1.2"
                    Width="16"
                    Height="16"/>
                </Button>
              </StackPanel>
            </Grid>
          </Grid>
        </Border>
        <Border Grid.Row="3" Grid.Column="2" Style="{StaticResource ConverterEditorSurface}">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="*"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBox
              x:Name="OutputEditor"
              Text="{Binding Output, Mode=OneWay}"
              IsReadOnly="True"
              TextWrapping="Wrap"
              VerticalContentAlignment="Top"
              VerticalScrollBarVisibility="Auto"
              HorizontalScrollBarVisibility="Disabled"
              FontFamily="Consolas"
              Padding="10"
              BorderThickness="0"
              Background="Transparent"/>
            <Grid Grid.Row="1" Margin="6">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock
                Text="{Binding OutputByteCountText}"
                Foreground="{DynamicResource Muted}"
                Margin="4,0"
                VerticalAlignment="Center"/>
              <Button
                x:Name="CopyOutputButton"
                Grid.Column="1"
                Command="{Binding CopyCommand}"
                Style="{StaticResource ConverterIconButton}"
                HorizontalAlignment="Right"
                ToolTip="{ui:Loc Key=UiConverterCopy}"
                AutomationProperties.Name="{ui:Loc Key=UiConverterCopy}">
                <Path
                  Data="{StaticResource CopyIcon}"
                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                  StrokeThickness="1.2"
                  Width="16"
                  Height="16"/>
              </Button>
            </Grid>
          </Grid>
        </Border>
        <StackPanel Grid.Row="5" Grid.ColumnSpan="3" Margin="0,12,0,0">
          <TextBlock Text="{Binding Error}" Foreground="{DynamicResource Error}" TextWrapping="Wrap"/>
          <TextBlock
            Text="{ui:Loc Key=UiConverterHint}"
            Foreground="{DynamicResource Muted}"
            FontSize="11"
            TextWrapping="Wrap"
            ToolTip="{ui:Loc Key=UiConverterDetails}"
            Margin="0,6,0,0"/>
        </StackPanel>
      </Grid>
      <Border
        x:Name="CopiedToast"
        Grid.Row="1"
        Panel.ZIndex="10"
        Visibility="Collapsed"
        IsHitTestVisible="False"
        HorizontalAlignment="Center"
        VerticalAlignment="Bottom"
        Margin="16,0,16,64"
        Padding="16,10"
        CornerRadius="6"
        Background="{DynamicResource Raised}"
        BorderBrush="{DynamicResource Outline}"
        BorderThickness="1">
        <StackPanel Orientation="Horizontal">
          <Path
            Data="M 1 7 L 5 11 L 13 2"
            Stroke="{DynamicResource Accent}"
            StrokeThickness="1.6"
            Width="16"
            Height="14"
            VerticalAlignment="Center"
            Margin="0,0,8,0"/>
          <TextBlock Text="{ui:Loc Key=UiConverterCopied}"/>
        </StackPanel>
      </Border>
    </Grid>
  </Border>
</Window>
