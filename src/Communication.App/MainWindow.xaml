<Window
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:ui="clr-namespace:Communication.App.Presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:views="clr-namespace:Communication.App.Views"
  xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
  x:Class="Communication.App.MainWindow"
  Title="Communication Studio"
  Width="1480"
  Height="940"
  MinWidth="1120"
  MinHeight="760"
  WindowStartupLocation="CenterScreen"
  WindowState="Maximized"
  WindowStyle="None"
  ResizeMode="CanResize"
  Style="{StaticResource {x:Type Window}}">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome
      CaptionHeight="46"
      ResizeBorderThickness="6"
      GlassFrameThickness="0"
      CornerRadius="0"
      UseAeroCaptionButtons="False"/>
  </shell:WindowChrome.WindowChrome>
  <Window.InputBindings>
    <KeyBinding Key="N" Modifiers="Control" Command="{Binding NewConnectionCommand}"/>
    <KeyBinding Key="S" Modifiers="Control" Command="{Binding Workspace.SaveCommand}"/>
    <KeyBinding Key="Enter" Modifiers="Control" Command="{Binding Workspace.SendCommand}"/>
    <KeyBinding Key="L" Modifiers="Control" Command="{Binding Workspace.ClearCommand}"/>
    <KeyBinding Key="F1" Modifiers="Control" Command="{Binding ConnectionsCommand}"/>
    <KeyBinding Key="F2" Modifiers="Control" Command="{Binding ModbusCommand}"/>
    <KeyBinding Key="D1" Modifiers="Control" Command="{Binding ChecksumCommand}"/>
    <KeyBinding Key="D2" Modifiers="Control" Command="{Binding DataConverterCommand}"/>
  </Window.InputBindings>
  <Border BorderBrush="{DynamicResource Outline}" BorderThickness="1">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="46"/>
        <RowDefinition Height="34"/>
        <RowDefinition Height="46"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="30"/>
      </Grid.RowDefinitions>
      <Grid Background="{DynamicResource Surface}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" Margin="16,0">
          <Image Source="/CommunicationStudio;component/Assets/AppIcon.png" Width="27" Height="27" Margin="0,0,10,0"/>
          <TextBlock Text="Communication Studio" FontSize="17" FontWeight="SemiBold"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
          <TextBlock
            Text="{ui:Loc Source={Binding Workspace.Summary}}"
            Foreground="{DynamicResource Muted}"
            FontSize="11"
            Margin="0,0,20,0"/>
          <Button
            Content="—"
            Style="{StaticResource CaptionButton}"
            Click="MinimizeClick"
            ToolTip="{ui:Loc Key=UiMinimize}"/>
          <Button
            x:Name="MaximizeButton"
            Style="{StaticResource CaptionButton}"
            Click="MaximizeClick"
            ToolTip="{ui:Loc Key=UiMaximizeRestore}">
            <Path
              Width="12"
              Height="12"
              Stretch="None"
              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
              StrokeThickness="1">
              <Path.Style>
                <Style TargetType="Path">
                  <Setter Property="Data" Value="M 1 1 H 11 V 11 H 1 Z"/>
                  <Style.Triggers>
                    <DataTrigger
                      Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}"
                      Value="Maximized">
                      <Setter Property="Data" Value="M 4 4 V 1 H 11 V 8 H 8 M 1 4 H 8 V 11 H 1 Z"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Path.Style>
            </Path>
          </Button>
          <Button
            Content="✕"
            Style="{StaticResource CloseCaptionButton}"
            Click="CloseClick"
            ToolTip="{ui:Loc Key=UiClose}"/>
        </StackPanel>
      </Grid>
      <Menu Grid.Row="1" Background="{DynamicResource Surface}" Foreground="{DynamicResource Text}" Padding="10,0">
        <MenuItem Header="{ui:Loc Key=UiFile}">
          <MenuItem
            Header="{ui:Loc Key=UiNewEndpoint}"
            Command="{Binding NewConnectionCommand}"
            InputGestureText="Ctrl+N"/>
          <MenuItem
            Header="{ui:Loc Key=UiSaveEndpointProfiles}"
            Command="{Binding Workspace.SaveCommand}"
            InputGestureText="Ctrl+S"/>
          <Separator/>
          <MenuItem Header="{ui:Loc Key=UiExit}" Click="CloseClick"/>
        </MenuItem>
        <MenuItem Header="{ui:Loc Key=UiWorkspace}">
          <MenuItem
            Header="{ui:Loc Key=UiEndpointManager}"
            Command="{Binding ConnectionsCommand}"
            InputGestureText="Ctrl+F1"/>
          <MenuItem Header="{ui:Loc Key=UiModbus}" Command="{Binding ModbusCommand}" InputGestureText="Ctrl+F2"/>
        </MenuItem>
        <MenuItem Header="{ui:Loc Key=UiTools}">
          <MenuItem Header="{ui:Loc Key=UiChecksums}" Command="{Binding ChecksumCommand}" InputGestureText="Ctrl+1"/>
          <MenuItem
            Header="{ui:Loc Key=UiDataConverter}"
            Command="{Binding DataConverterCommand}"
            InputGestureText="Ctrl+2"/>
        </MenuItem>
        <MenuItem Header="{ui:Loc Key=Appearance}">
          <MenuItem
            Header="{ui:Loc Key=LightTheme}"
            IsChecked="{Binding IsLight, Source={x:Static ui:Appearance.Current}, Mode=OneWay}"
            Click="LightThemeClick"/>
          <MenuItem
            Header="{ui:Loc Key=DarkTheme}"
            IsChecked="{Binding IsDark, Source={x:Static ui:Appearance.Current}, Mode=OneWay}"
            Click="DarkThemeClick"/>
        </MenuItem>
        <MenuItem Header="{ui:Loc Key=LanguageMenu}">
          <MenuItem
            Header="中文"
            IsChecked="{Binding IsChinese, Source={x:Static ui:Appearance.Current}, Mode=OneWay}"
            Click="ChineseClick"/>
          <MenuItem
            Header="English"
            IsChecked="{Binding IsEnglish, Source={x:Static ui:Appearance.Current}, Mode=OneWay}"
            Click="EnglishClick"/>
        </MenuItem>
        <MenuItem Header="{ui:Loc Key=UiHelp}">
          <MenuItem Header="{ui:Loc Key=UiAboutCommunicationStudio}" Click="AboutClick"/>
        </MenuItem>
      </Menu>
      <TabControl Grid.Row="2" Grid.RowSpan="2" SelectedIndex="{Binding SelectedPageIndex}" BorderThickness="0">
        <TabItem Header="{ui:Loc Key=UiEndpointManager}">
          <views:ConnectionsView DataContext="{Binding Workspace}"/>
        </TabItem>
        <TabItem Header="{ui:Loc Key=UiModbus}">
          <views:ModbusView DataContext="{Binding Modbus}"/>
        </TabItem>
      </TabControl>
      <Border Grid.Row="4" Background="{DynamicResource StatusSurface}" Padding="16,0">
        <DockPanel>
          <TextBlock
            DockPanel.Dock="Right"
            Text=".NET 10 / WPF · v0.2"
            Foreground="{DynamicResource Muted}"
            FontSize="10"
            HorizontalAlignment="Right"
            Margin="16,0,0,0"/>
          <TextBlock Text="{ui:Loc Source={Binding Page}}" FontSize="11" Margin="0,0,18,0"/>
          <TextBlock
            Text="{ui:Loc Source={Binding Status}}"
            FontSize="11"
            TextTrimming="CharacterEllipsis"
            Foreground="{DynamicResource Muted}"/>
        </DockPanel>
      </Border>
    </Grid>
  </Border>
</Window>
