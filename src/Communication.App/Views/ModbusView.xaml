<UserControl
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:ui="clr-namespace:Communication.App.Presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  x:Class="Communication.App.Views.ModbusView">
  <UserControl.Resources>
    <Style
      x:Key="LogFilterHeader"
      TargetType="DataGridColumnHeader"
      BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
      <Setter Property="ToolTip" Value="{ui:Loc Key=LogFilterHint}"/>
      <EventSetter Event="PreviewMouseRightButtonUp" Handler="LogFilterHeaderRightClick" HandledEventsToo="True"/>
    </Style>
    <Style x:Key="LogLevelHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource LogFilterHeader}">
      <Setter Property="Tag" Value="Level"/>
      <Style.Triggers>
        <DataTrigger
          Binding="{Binding DataContext.LevelFilter.IsFiltered, RelativeSource={RelativeSource AncestorType=DataGrid}}"
          Value="True">
          <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="LogTypeHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource LogFilterHeader}">
      <Setter Property="Tag" Value="Type"/>
      <Style.Triggers>
        <DataTrigger
          Binding="{Binding DataContext.TypeFilter.IsFiltered, RelativeSource={RelativeSource AncestorType=DataGrid}}"
          Value="True">
          <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="LogRoleHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource LogFilterHeader}">
      <Setter Property="Tag" Value="Role"/>
      <Style.Triggers>
        <DataTrigger
          Binding="{Binding DataContext.RoleFilter.IsFiltered, RelativeSource={RelativeSource AncestorType=DataGrid}}"
          Value="True">
          <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="LogEndpointHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource LogFilterHeader}">
      <Setter Property="Tag" Value="Endpoint"/>
      <Style.Triggers>
        <DataTrigger
          Binding="{Binding DataContext.EndpointFilter.IsFiltered, RelativeSource={RelativeSource AncestorType=DataGrid}}"
          Value="True">
          <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <DataTemplate x:Key="LogTimeHeader">
      <StackPanel Orientation="Horizontal" ToolTip="{ui:Loc Key=UiClickToToggleAscendingDescendingTimeOrder}">
        <TextBlock Text="{ui:Loc Key=UiTime}" VerticalAlignment="Center"/>
        <StackPanel Margin="7,0,0,0" VerticalAlignment="Center">
          <Path Data="M 0 4 L 4 0 L 8 4 Z" Width="8" Height="4" Margin="0,0,0,3">
            <Path.Style>
              <Style TargetType="Path">
                <Setter Property="Fill" Value="{DynamicResource Muted}"/>
                <Setter Property="Opacity" Value="0.35"/>
                <Style.Triggers>
                  <DataTrigger
                    Binding="{Binding DataContext.TimeAscending, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                    Value="True">
                    <Setter Property="Fill" Value="{DynamicResource Accent}"/>
                    <Setter Property="Opacity" Value="1"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Path.Style>
          </Path>
          <Path Data="M 0 0 L 4 4 L 8 0 Z" Width="8" Height="4">
            <Path.Style>
              <Style TargetType="Path">
                <Setter Property="Fill" Value="{DynamicResource Muted}"/>
                <Setter Property="Opacity" Value="0.35"/>
                <Style.Triggers>
                  <DataTrigger
                    Binding="{Binding DataContext.TimeAscending, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                    Value="False">
                    <Setter Property="Fill" Value="{DynamicResource Accent}"/>
                    <Setter Property="Opacity" Value="1"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Path.Style>
          </Path>
        </StackPanel>
      </StackPanel>
    </DataTemplate>
    <Style x:Key="RegisterValidationBorder" TargetType="Border">
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="CornerRadius" Value="4"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding HasEditError}" Value="True">
          <Setter Property="BorderBrush" Value="{DynamicResource Error}"/>
          <Setter Property="ToolTip" Value="{Binding EditError}"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="BitComboBox" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid Background="Transparent">
              <ToggleButton
                Focusable="False"
                IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                <ToggleButton.Template>
                  <ControlTemplate TargetType="ToggleButton">
                    <Border Background="Transparent">
                      <Path
                        Data="M 0 0 L 4 4 L 8 0"
                        Stroke="{DynamicResource Muted}"
                        StrokeThickness="1.5"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="0,0,10,0"/>
                    </Border>
                  </ControlTemplate>
                </ToggleButton.Template>
              </ToggleButton>
              <ContentPresenter
                IsHitTestVisible="False"
                Content="{TemplateBinding SelectionBoxItem}"
                ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                Margin="5,2,26,2"
                VerticalAlignment="Center"
                TextElement.Foreground="{DynamicResource Text}"/>
              <Border
                x:Name="FocusBorder"
                BorderBrush="Transparent"
                BorderThickness="1"
                CornerRadius="4"
                IsHitTestVisible="False"/>
              <Popup
                x:Name="PART_Popup"
                IsOpen="{TemplateBinding IsDropDownOpen}"
                Placement="Bottom"
                AllowsTransparency="True">
                <Border
                  Background="{DynamicResource Raised}"
                  BorderBrush="{DynamicResource Outline}"
                  BorderThickness="1"
                  CornerRadius="5"
                  Padding="3"
                  MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                  <ItemsPresenter/>
                </Border>
              </Popup>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter TargetName="FocusBorder" Property="BorderBrush" Value="{DynamicResource Accent}"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="FocusBorder" Property="BorderBrush" Value="{DynamicResource Outline}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <DataTemplate x:Key="RegisterValueDisplay">
      <TextBlock Text="{Binding EditValue}"/>
    </DataTemplate>
    <DataTemplate x:Key="RegisterValueEditor">
      <TextBox
        Text="{Binding EditValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
        Style="{StaticResource {x:Type TextBox}}"
        Loaded="RegisterEditorLoaded"
        LostKeyboardFocus="RegisterEditorLostFocus"
        Padding="5,2"
        VerticalAlignment="Center"
        ToolTip="{ui:Loc Key=UiDecimal065535OrHexadecimalWithA}"/>
    </DataTemplate>
    <DataTemplate x:Key="BitValueEditor">
      <ComboBox
        ItemsSource="{Binding BitOptions}"
        SelectedItem="{Binding EditValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
        Style="{StaticResource BitComboBox}"
        IsEditable="False"
        MinHeight="27"
        Padding="5,2"
        VerticalAlignment="Center"
        ToolTip="{ui:Loc Key=UiBitValuesMustBe0Or1}"/>
    </DataTemplate>
    <DataTemplate x:Key="RegisterCellDisplay">
      <Border Style="{StaticResource RegisterValidationBorder}">
        <ContentControl Content="{Binding}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center">
          <ContentControl.Style>
            <Style TargetType="ContentControl">
              <Setter Property="ContentTemplate" Value="{StaticResource RegisterValueDisplay}"/>
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsBit}" Value="True">
                  <Setter Property="ContentTemplate" Value="{StaticResource BitValueEditor}"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </ContentControl.Style>
        </ContentControl>
      </Border>
    </DataTemplate>
    <DataTemplate x:Key="RegisterCellEditor">
      <Border BorderThickness="1" BorderBrush="Transparent" CornerRadius="4">
        <ContentControl Content="{Binding}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center">
          <ContentControl.Style>
            <Style TargetType="ContentControl">
              <Setter Property="ContentTemplate" Value="{StaticResource RegisterValueEditor}"/>
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsBit}" Value="True">
                  <Setter Property="ContentTemplate" Value="{StaticResource BitValueEditor}"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </ContentControl.Style>
        </ContentControl>
      </Border>
    </DataTemplate>
  </UserControl.Resources>
  <Grid Margin="24,18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="5"/>
      <RowDefinition Height="225" MinHeight="150"/>
    </Grid.RowDefinitions>
    <Grid Margin="0,0,0,18">
      <Grid.ColumnDefinitions>
        <ColumnDefinition/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="{ui:Loc Key=UiModbus}" FontSize="24" FontWeight="SemiBold"/>
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal">
        <Button
          Content="{ui:Loc Key=UiMasterMode}"
          Command="{Binding MasterModeCommand}"
          Style="{StaticResource NavigationButton}"
          Tag="{Binding MasterMode}"
          Margin="0,0,8,0"/>
        <Button
          Content="{ui:Loc Key=UiSlaveMode}"
          Command="{Binding SlaveModeCommand}"
          Style="{StaticResource NavigationButton}"
          Tag="{Binding SlaveMode}"/>
      </StackPanel>
    </Grid>
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="275"/>
        <ColumnDefinition Width="16"/>
        <ColumnDefinition/>
      </Grid.ColumnDefinitions>
      <Border
        Background="{DynamicResource Surface}"
        BorderBrush="{DynamicResource Outline}"
        BorderThickness="1"
        CornerRadius="6">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="16">
            <TextBlock Text="{ui:Loc Key=UiProtocol}" Style="{StaticResource MutedLabel}" Margin="0,0,0,6"/>
            <ComboBox
              ItemsSource="{Binding Transports}"
              SelectedItem="{Binding Transport}"
              IsEnabled="{Binding CanChangeProtocol}"
              Margin="0,0,0,16"
              ToolTip="{ui:Loc Key=UiStopTheSlaveAndCloseRTUPorts}">
              <ComboBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock>
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Setter Property="Text" Value="Modbus TCP"/>
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding}" Value="Rtu">
                            <Setter Property="Text" Value="Modbus RTU"/>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <StackPanel Visibility="{Binding IsRtu, Converter={StaticResource BoolVis}}">
              <TextBlock Text="{ui:Loc Key=UiRTUSerialPort}" FontWeight="SemiBold"/>
              <StackPanel IsEnabled="{Binding CanConfigureSerial}">
                <TextBlock Text="{ui:Loc Key=UiSerialPort}" Style="{StaticResource MutedLabel}"/>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <ComboBox
                    IsEditable="True"
                    IsTextSearchEnabled="False"
                    ItemsSource="{Binding SerialPorts}"
                    Text="{Binding SerialPortName, UpdateSourceTrigger=PropertyChanged}"/>
                  <Button
                    Grid.Column="1"
                    Content="↻"
                    Command="{Binding RefreshPortsCommand}"
                    ToolTip="{ui:Loc Key=UiRefreshPorts}"
                    Padding="9,5"
                    Margin="6,0,0,0"/>
                </Grid>
                <TextBlock
                  Text="{ui:Loc Source={Binding SerialWarning}}"
                  Foreground="{DynamicResource Error}"
                  TextWrapping="Wrap"
                  Margin="0,6,0,0">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding SerialWarning}" Value="">
                          <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="{ui:Loc Key=UiBaudRate}" Style="{StaticResource MutedLabel}"/>
                <TextBox Text="{Binding BaudRate, UpdateSourceTrigger=PropertyChanged}"/>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition/>
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="{ui:Loc Key=UiParity}" Style="{StaticResource MutedLabel}"/>
                    <ComboBox ItemsSource="{Binding ParityOptions}" SelectedItem="{Binding SerialParity}"/>
                  </StackPanel>
                  <StackPanel Grid.Column="2">
                    <TextBlock Text="{ui:Loc Key=UiStopBits}" Style="{StaticResource MutedLabel}"/>
                    <ComboBox ItemsSource="{Binding StopBitsOptions}" SelectedItem="{Binding SerialStopBits}"/>
                  </StackPanel>
                </Grid>
                <TextBlock Text="{ui:Loc Key=UiResponseTimeoutMs}" Style="{StaticResource MutedLabel}"/>
                <TextBox Text="{Binding ResponseTimeout, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock
                  Text="{ui:Loc Key=Ui8DataBitsRTUFramesIncludeCRC16}"
                  FontSize="11"
                  Foreground="{DynamicResource Muted}"
                  TextWrapping="Wrap"
                  Margin="0,10,0,12"/>
              </StackPanel>
            </StackPanel>
            <StackPanel Visibility="{Binding MasterMode, Converter={StaticResource BoolVis}}">
              <TextBlock Text="{ui:Loc Key=UiMasterEndpoint}" FontWeight="SemiBold"/>
              <StackPanel IsEnabled="{Binding CanConfigureMaster}">
                <StackPanel Visibility="{Binding IsTcp, Converter={StaticResource BoolVis}}">
                  <TextBlock Text="{ui:Loc Key=UiRemoteHost}" Style="{StaticResource MutedLabel}"/>
                  <ComboBox
                    Style="{StaticResource IpAddressPicker}"
                    ItemsSource="{x:Static ui:IpAddressPresets.Remote}"
                    Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}"/>
                  <TextBlock Text="{ui:Loc Key=UiTCPPort}" Style="{StaticResource MutedLabel}"/>
                  <TextBox Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
                <TextBlock Text="Unit ID" Style="{StaticResource MutedLabel}"/>
                <TextBox Text="{Binding Unit, UpdateSourceTrigger=PropertyChanged}"/>
              </StackPanel>
              <StackPanel Visibility="{Binding IsRtu, Converter={StaticResource BoolVis}}">
                <UniformGrid Columns="2" Margin="0,12,0,0">
                  <Button
                    Content="{ui:Loc Key=UiOpenPort}"
                    Command="{Binding ConnectRtuCommand}"
                    Style="{StaticResource Primary}"
                    Margin="0,0,6,0"/>
                  <Button Content="{ui:Loc Key=UiClosePort}" Command="{Binding DisconnectRtuCommand}"/>
                </UniformGrid>
                <TextBlock
                  Text="{ui:Loc Source={Binding MasterConnectionStatus}}"
                  Foreground="{DynamicResource Accent}"
                  Margin="0,8,0,0"/>
              </StackPanel>
            </StackPanel>
            <StackPanel Visibility="{Binding SlaveMode, Converter={StaticResource BoolVis}}">
              <TextBlock Text="{ui:Loc Key=UiSlaveListeningOn}" FontWeight="SemiBold"/>
              <StackPanel IsEnabled="{Binding CanConfigureSlave}">
                <StackPanel Visibility="{Binding IsTcp, Converter={StaticResource BoolVis}}">
                  <TextBlock Text="{ui:Loc Key=UiLocalIP}" Style="{StaticResource MutedLabel}"/>
                  <ComboBox
                    Style="{StaticResource IpAddressPicker}"
                    ItemsSource="{x:Static ui:IpAddressPresets.Bind}"
                    Text="{Binding LocalAddress, UpdateSourceTrigger=PropertyChanged}"/>
                  <TextBlock Text="{ui:Loc Key=UiListenPort}" Style="{StaticResource MutedLabel}"/>
                  <TextBox Text="{Binding LocalPort, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
                <TextBlock Text="Unit ID" Style="{StaticResource MutedLabel}"/>
                <TextBox Text="{Binding SlaveUnit, UpdateSourceTrigger=PropertyChanged}"/>
              </StackPanel>
              <UniformGrid Columns="2" Margin="0,12,0,0">
                <Button
                  Content="{ui:Loc Key=UiStartSlave}"
                  Command="{Binding StartSlaveCommand}"
                  Style="{StaticResource Primary}"
                  Margin="0,0,6,0"/>
                <Button Content="{ui:Loc Key=UiStop}" Command="{Binding StopSlaveCommand}"/>
              </UniformGrid>
              <TextBlock
                Text="{ui:Loc Source={Binding SlaveStatus}}"
                Foreground="{DynamicResource Accent}"
                Margin="0,8,0,0"/>
            </StackPanel>
            <TextBlock
              Text="{ui:Loc Source={Binding SelectedSection.Description, TargetNullValue=请新建寄存器标签}}"
              TextWrapping="Wrap"
              Foreground="{DynamicResource Muted}"
              Margin="0,20,0,0"/>
            <StackPanel Visibility="{Binding MasterMode, Converter={StaticResource BoolVis}}">
              <Button
                Content="{ui:Loc Key=UiReadTable}"
                Command="{Binding ReadCommand}"
                Style="{StaticResource Primary}"
                Margin="0,14,0,0"/>
              <TextBlock Text="{ui:Loc Key=UiPollIntervalMs}" Style="{StaticResource MutedLabel}"/>
              <TextBox
                Text="{Binding PollInterval, UpdateSourceTrigger=PropertyChanged}"
                IsEnabled="{Binding CanConfigureMaster}"/>
              <Button Content="{ui:Loc Source={Binding PollLabel}}" Command="{Binding PollCommand}" Margin="0,8,0,0"/>
            </StackPanel>
            <TextBlock
              Text="{ui:Loc Key=UiAddressesUseZeroBasedOffsets40001Is}"
              TextWrapping="Wrap"
              Foreground="{DynamicResource Muted}"
              FontSize="11"
              Margin="0,18,0,0"/>
          </StackPanel>
        </ScrollViewer>
      </Border>
      <Border Grid.Column="2" BorderBrush="{DynamicResource Outline}" BorderThickness="1" CornerRadius="6">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <StackPanel Background="{DynamicResource Surface}">
            <DockPanel>
              <Button
                DockPanel.Dock="Right"
                Content="{ui:Loc Key=UiNew}"
                Click="NewSectionClick"
                Padding="10,5"
                Margin="8,6"
                VerticalAlignment="Top"/>
              <TabControl ItemsSource="{Binding Sections}" SelectedItem="{Binding SelectedSection}" BorderThickness="0">
                <TabControl.Template>
                  <ControlTemplate TargetType="TabControl">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                      <StackPanel Orientation="Horizontal" IsItemsHost="True"/>
                    </ScrollViewer>
                  </ControlTemplate>
                </TabControl.Template>
                <TabControl.ItemContainerStyle>
                  <Style TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}">
                    <Setter Property="ToolTip" Value="{ui:Loc Source={Binding Description}}"/>
                    <Setter Property="ContextMenu">
                      <Setter.Value>
                        <ContextMenu
                          Background="{DynamicResource Raised}"
                          Foreground="{DynamicResource Text}"
                          BorderBrush="{DynamicResource Outline}"
                          BorderThickness="1"/>
                      </Setter.Value>
                    </Setter>
                    <EventSetter Event="ContextMenuOpening" Handler="SectionContextMenuOpening"/>
                  </Style>
                </TabControl.ItemContainerStyle>
                <TabControl.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding Name}"/>
                  </DataTemplate>
                </TabControl.ItemTemplate>
              </TabControl>
            </DockPanel>
            <TextBlock
              Text="{ui:Loc Source={Binding SelectedSection.Description, TargetNullValue=尚未选择寄存器区}}"
              Foreground="{DynamicResource Muted}"
              FontSize="11"
              Margin="14,6,14,10"
              TextWrapping="Wrap"/>
          </StackPanel>
          <DataGrid
            x:Name="RegisterGrid"
            Grid.Row="1"
            ItemsSource="{Binding Rows}"
            SelectedItem="{Binding Selected}"
            IsReadOnly="False"
            RowHeight="35"
            PreviewMouseLeftButtonDown="RegisterGridMouseDown"
            CellEditEnding="RegisterCellEditEnding">
            <DataGrid.Columns>
              <DataGridTextColumn
                Header="{ui:Loc Key=UiOffset}"
                Binding="{Binding Address}"
                Width="65"
                IsReadOnly="True"/>
              <DataGridTextColumn
                Header="{ui:Loc Key=UiCurrentValue}"
                Binding="{Binding Value}"
                Width="105"
                IsReadOnly="True"/>
              <DataGridTextColumn Header="HEX" Binding="{Binding Hex}" Width="85" IsReadOnly="True"/>
              <DataGridTextColumn Header="INT16" Binding="{Binding Signed}" Width="75" IsReadOnly="True"/>
              <DataGridTemplateColumn
                Header="{ui:Loc Key=UiWriteValueEditable}"
                CellTemplate="{StaticResource RegisterCellDisplay}"
                CellEditingTemplate="{StaticResource RegisterCellEditor}"
                Width="150"/>
              <DataGridTextColumn
                Header="{ui:Loc Key=UiUpdated}"
                Binding="{Binding Updated}"
                Width="*"
                MinWidth="120"
                IsReadOnly="True"/>
            </DataGrid.Columns>
          </DataGrid>
          <StackPanel Grid.Row="2" Margin="12">
            <TextBlock
              Text="{ui:Loc Source={Binding EditValidationSummary}}"
              Foreground="{DynamicResource Error}"
              TextWrapping="Wrap"
              Margin="0,0,0,8">
              <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding EditValidationSummary}" Value="">
                      <Setter Property="Visibility" Value="Collapsed"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
            <TextBlock
              Text="{ui:Loc Source={Binding Status}}"
              TextWrapping="Wrap"
              Foreground="{DynamicResource Muted}"
              Margin="0,0,0,10"/>
            <StackPanel Orientation="Horizontal" Visibility="{Binding MasterMode, Converter={StaticResource BoolVis}}">
              <Button
                Content="{ui:Loc Key=UiWriteSelectedRow}"
                Command="{Binding WriteSelectedCommand}"
                Margin="0,0,8,0"/>
              <Button Content="{ui:Loc Key=UiWriteEntireTable}" Command="{Binding WriteTableCommand}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
              <Button
                Content="{ui:Loc Key=UiApplyWriteValues}"
                Command="{Binding ApplySlaveCommand}"
                Visibility="{Binding SlaveMode, Converter={StaticResource BoolVis}}"
                Style="{StaticResource Primary}"
                Margin="0,0,8,0"/>
              <Button
                Content="{ui:Loc Key=UiRevertEdits}"
                Command="{Binding RevertEditsCommand}"
                Click="RevertEditsClick"
                ToolTip="{ui:Loc Key=UiRestoreUnappliedEditsToCurrentValuesData}"/>
            </StackPanel>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
    <GridSplitter Grid.Row="2" HorizontalAlignment="Stretch" Margin="0,2,0,0"/>
    <Grid Grid.Row="3" Margin="0,10,0,0">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition/>
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition MinWidth="450"/>
        <ColumnDefinition Width="5"/>
        <ColumnDefinition Width="320" MinWidth="240"/>
      </Grid.ColumnDefinitions>
      <DockPanel Grid.ColumnSpan="3" Margin="0,0,0,6">
        <Button
          DockPanel.Dock="Right"
          Content="{ui:Loc Key=UiClearLog}"
          Command="{Binding ClearLogsCommand}"
          Padding="10,4"
          HorizontalAlignment="Right"/>
        <TextBlock
          Text="{ui:Loc Key=UiEventLog}"
          Foreground="{DynamicResource Muted}"
          VerticalAlignment="Center"
          Margin="10,0,0,0"/>
      </DockPanel>
      <DataGrid
        x:Name="LogGrid"
        Grid.Row="1"
        ItemsSource="{Binding LogsView}"
        SelectedItem="{Binding SelectedLog, Mode=TwoWay}"
        Sorting="LogGridSorting"
        CanUserSortColumns="True"
        RowHeight="NaN"
        MinRowHeight="30"
        ToolTip="{ui:Loc Key=UiSelectATrafficEntryToInspectIts}">
        <DataGrid.Columns>
          <DataGridTextColumn
            Header="{ui:Loc Key=UiTime}"
            HeaderTemplate="{StaticResource LogTimeHeader}"
            SortMemberPath="Timestamp"
            Binding="{Binding Time}"
            Width="110"/>
          <DataGridTextColumn
            Header="{ui:Loc Key=UiLevel}"
            HeaderStyle="{StaticResource LogLevelHeader}"
            CanUserSort="False"
            Binding="{Binding Level}"
            Width="75"/>
          <DataGridTextColumn
            Header="{ui:Loc Key=UiType}"
            HeaderStyle="{StaticResource LogTypeHeader}"
            CanUserSort="False"
            Binding="{ui:Loc Source={Binding Type}}"
            Width="100"/>
          <DataGridTextColumn
            Header="{ui:Loc Key=UiRole}"
            HeaderStyle="{StaticResource LogRoleHeader}"
            CanUserSort="False"
            Binding="{ui:Loc Source={Binding Role}}"
            Width="78"/>
          <DataGridTextColumn
            Header="{ui:Loc Key=UiDirection}"
            CanUserSort="False"
            Binding="{Binding Direction}"
            Width="80"/>
          <DataGridTextColumn
            Header="{ui:Loc Key=UiPeer}"
            HeaderStyle="{StaticResource LogEndpointHeader}"
            CanUserSort="False"
            Binding="{Binding Endpoint}"
            Width="150"/>
          <DataGridTemplateColumn
            Header="{ui:Loc Key=UiDetailedInformation}"
            CanUserSort="False"
            Width="*"
            MinWidth="240">
            <DataGridTemplateColumn.HeaderStyle>
              <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                <Setter Property="ToolTip" Value="{ui:Loc Key=UiEventCompleteModbusFrameHEXTCPIncludes}"/>
              </Style>
            </DataGridTemplateColumn.HeaderStyle>
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <StackPanel Margin="0,5">
                  <TextBlock Text="{ui:Loc Source={Binding Message}}" TextWrapping="Wrap"/>
                  <TextBox
                    Text="{Binding Hex, Mode=OneWay}"
                    IsReadOnly="True"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="0"
                    FontFamily="Consolas"
                    FontSize="12"
                    Foreground="{DynamicResource Accent}"
                    TextWrapping="Wrap"
                    Margin="0,5,0,0"
                    ToolTip="{ui:Loc Key=UiRawModbusFrameSelectTextToCopy}">
                    <TextBox.Style>
                      <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding Hex}" Value="">
                            <Setter Property="Visibility" Value="Collapsed"/>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBox.Style>
                  </TextBox>
                </StackPanel>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
        </DataGrid.Columns>
      </DataGrid>
      <GridSplitter
        Grid.Row="1"
        Grid.Column="1"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"
        ResizeDirection="Columns"
        ResizeBehavior="PreviousAndNext"
        Background="{DynamicResource Outline}"/>
      <Border
        Grid.Row="1"
        Grid.Column="2"
        Margin="8,0,0,0"
        BorderBrush="{DynamicResource Outline}"
        BorderThickness="1"
        CornerRadius="5"
        Background="{DynamicResource Surface}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
          </Grid.RowDefinitions>
          <TextBlock Text="{ui:Loc Key=UiPacket}" FontWeight="SemiBold" Margin="12,8"/>
          <TextBlock
            Grid.Row="1"
            Text="{ui:Loc Key=UiSelectATrafficEntryToInspectItsL115}"
            TextWrapping="Wrap"
            Foreground="{DynamicResource Muted}"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Margin="12">
            <TextBlock.Style>
              <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding HasSelectedPacket}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
          <ScrollViewer
            x:Name="PacketScrollViewer"
            Grid.Row="1"
            PreviewMouseWheel="PacketPreviewMouseWheel"
            VerticalScrollBarVisibility="Auto"
            HorizontalScrollBarVisibility="Disabled"
            Visibility="{Binding HasSelectedPacket, Converter={StaticResource BoolVis}}">
            <StackPanel DataContext="{Binding SelectedPacket}" Margin="12,0,12,12">
              <TextBlock
                Text="{ui:Loc Source={Binding Summary}}"
                TextWrapping="Wrap"
                FontSize="11"
                Foreground="{DynamicResource Muted}"
                Margin="0,0,0,12"/>
              <TextBlock Text="{ui:Loc Key=UiRawHexadecimal}" FontWeight="SemiBold" Margin="0,0,0,6"/>
              <TextBox
                Text="{Binding Hex, Mode=OneWay}"
                IsReadOnly="True"
                TextWrapping="Wrap"
                FontFamily="Consolas"
                FontSize="12"
                Background="Transparent"
                BorderThickness="0"
                Padding="0"
                Foreground="{DynamicResource Accent}"/>
              <TextBlock Text="{ui:Loc Key=UiRawBinary}" FontWeight="SemiBold" Margin="0,14,0,6"/>
              <TextBox
                Text="{Binding Binary, Mode=OneWay}"
                IsReadOnly="True"
                TextWrapping="Wrap"
                FontFamily="Consolas"
                FontSize="11"
                Background="Transparent"
                BorderThickness="0"
                Padding="0"
                ToolTip="{ui:Loc Key=UiCommasSeparateProtocolFieldsOriginalByteOrder}"/>
              <TextBlock Text="{ui:Loc Key=UiPacketFields}" FontWeight="SemiBold" Margin="0,14,0,6"/>
              <DataGrid
                x:Name="PacketSemanticGrid"
                ItemsSource="{Binding Fields}"
                CanUserSortColumns="False"
                CanUserResizeColumns="True"
                RowHeight="NaN"
                MinRowHeight="28"
                EnableRowVirtualization="False"
                ScrollViewer.VerticalScrollBarVisibility="Disabled">
                <DataGrid.Columns>
                  <DataGridTemplateColumn Header="{ui:Loc Key=UiField}" Width="*" MinWidth="100">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <TextBlock
                          Text="{ui:Loc Source={Binding Field}}"
                          ToolTip="{ui:Loc Source={Binding Description}}"
                          TextWrapping="Wrap"
                          FontSize="11"
                          Margin="0,4"/>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTextColumn Header="{ui:Loc Key=UiDecimal}" Binding="{Binding Decimal}" Width="62"/>
                  <DataGridTemplateColumn Header="{ui:Loc Key=UiBinary}" Width="*" MinWidth="110">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <TextBlock
                          Text="{Binding Binary}"
                          TextWrapping="Wrap"
                          FontFamily="Consolas"
                          FontSize="10"
                          Margin="0,4"/>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                </DataGrid.Columns>
              </DataGrid>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </Border>
      <Popup x:Name="LogFilterPopup" Placement="Top" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
        <Border
          Background="{DynamicResource Raised}"
          BorderBrush="{DynamicResource Outline}"
          BorderThickness="1"
          CornerRadius="6"
          Padding="12"
          MinWidth="210"
          MaxWidth="360"
          PreviewKeyDown="LogFilterKeyDown">
          <StackPanel>
            <TextBlock
              Text="{ui:Loc Source={Binding Title, StringFormat={}{0}筛选}}"
              FontWeight="SemiBold"
              Margin="0,0,0,10"/>
            <UniformGrid Columns="2" Margin="0,0,0,8">
              <Button
                Content="{ui:Loc Key=UiSelectAll}"
                Click="LogFilterSelectAllClick"
                Padding="8,4"
                Margin="0,0,6,0"/>
              <Button Content="{ui:Loc Key=UiClearSelection}" Click="LogFilterClearClick" Padding="8,4"/>
            </UniformGrid>
            <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <ItemsControl ItemsSource="{Binding Options}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <CheckBox
                      Content="{ui:Loc Source={Binding Label}}"
                      IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                      Margin="0,5"
                      ToolTip="{ui:Loc Source={Binding Label}}"/>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </StackPanel>
        </Border>
      </Popup>
    </Grid>
  </Grid>
</UserControl>
